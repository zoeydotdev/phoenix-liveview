<Layouts.flash_group flash={@flash} />
<Component.hero content="Survey">
  Please fill out our survey
</Component.hero>
<div class="container mx-auto px-4 py-8 max-w-4xl">
  <%= if @demographic do %>
    <Show.details demographic={@demographic} />
  <% else %>
    <.live_component
      module={Form}
      id="demographic-form"
      current_scope={@current_scope}
    />
  <% end %>
</div>
