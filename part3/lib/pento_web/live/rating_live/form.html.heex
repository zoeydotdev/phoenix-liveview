<div>
  <.form
    for={@form}
    phx-submit="save"
    phx-target={@myself}
    id={"rating-form-#{@id}"}
  >
    <div class="flex items-center gap-2">
      <.input
        field={@form[:stars]}
        type="select"
        prompt={unfilled_stars(0) |> Enum.join()}
        options={star_options()}
      />
      <.button>Save</.button>
    </div>
    <input
      type="hidden"
      name={@form[:user_id].name}
      value={@form[:user_id].value}
    />
    <input
      type="hidden"
      name={@form[:product_id].name}
      value={@form[:product_id].value}
    />
  </.form>
</div>
